{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 \"./hooks/session-start-macstack-stale.py\"",
        "matcher": "startup|resume|clear",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "python3 \"./hooks/stop-macstack-stale.py\"",
        "timeout": 15
      }
    ]
  }
}