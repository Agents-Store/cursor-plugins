{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"./hooks/session-start-seen-skills.mjs\"",
        "matcher": "startup|resume|clear|compact"
      },
      {
        "command": "node \"./hooks/session-start-profiler.mjs\"",
        "matcher": "startup|resume|clear|compact"
      },
      {
        "command": "node \"./hooks/inject-claude-md.mjs\"",
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "postToolUse": [
      {
        "command": "node \"./hooks/posttooluse-skill-telemetry.mjs\"",
        "matcher": "Skill",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"./hooks/session-end-cleanup.mjs\""
      }
    ]
  }
}